#pragma once

/* Rede Wi-Fi à qual o aparelho se conecta. */
#define DEFAULT_WIFI_SSID "MinhaRedeWiFi"

/* Senha WPA2 da rede acima. Informação sensível. */
#define DEFAULT_WIFI_PASS "troque-esta-senha"

/* Host do servidor local que expõe /usage (tools/usage_server.py). */
#define TOKEN_USAGE_HOST "192.0.2.10"

/* Porta do servidor acima. */
#define TOKEN_USAGE_PORT "8787"
